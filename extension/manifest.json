{
    "name": "Double Right Click - close tab & more",
    "version": "3.1.0",
    "manifest_version": 3,
    "description": "Double right click anywhere on the page to close the tab, reopen the last closed tab and more.",
    "homepage_url": "https://webextensions.org/",
    "icons": {
        "16": "images/double-click-16x16.png",
        "128": "images/double-click-128x128.png"
    },
    "permissions": [
        "contextMenus",
        "scripting",
        "storage",
        "tabs"
    ],
    "optional_permissions": [
        "sessions"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "options_ui": {
        "page": "options.html"
    },
    "action": {
        "default_title": "Double Right Click - settings",
        "default_popup": "options.html?popup"
    },
    "background": {
        "service_worker": "include.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "scripts/double-right-click.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "match_origin_as_fallback": true
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "{6f6ede9c-d2e0-4c2c-b77d-eb98b801892c}",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}
