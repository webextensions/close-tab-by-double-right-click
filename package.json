{
    "name": "close-tab-by-double-right-click",
    "version": "2.3.0",
    "private": true,
    "description": "Browser extension \"Close Tab by Double Right Click\" for Google Chrome and Mozilla Firefox",
    "type": "module",
    "scripts": {
        "preversion": "npm test && npm run test:e2e",
        "version": "node scripts/build-and-release/prepare-version/prepare-version.js && git add extension/manifest.json",
        "postversion": "git push --follow-tags",
        "lint": "eslint .",
        "lint:firefox": "npm run build:firefox && web-ext lint",
        "start": "npm run build:dist:watch",
        "start:firefox": "npm run build:firefox && web-ext run --firefox-profile ./web-ext-profile --profile-create-if-missing --keep-profile-changes",
        "start:chrome": "npm run build:chrome && web-ext run --target chromium --source-dir dist/chrome",
        "build": "npm run build:dist && web-ext build --source-dir dist/chrome --filename \"{name}-{version}-chrome.zip\" && web-ext build --filename \"{name}-{version}-firefox.zip\"",
        "build:dist": "node scripts/build-and-release/build-dist/build-dist.js",
        "build:dist:watch": "node --watch-path=extension --watch-preserve-output scripts/build-and-release/build-dist/build-dist.js",
        "build:chrome": "node scripts/build-and-release/build-dist/build-dist.js chrome",
        "build:firefox": "node scripts/build-and-release/build-dist/build-dist.js firefox",
        "test": "npm run lint && npm run lint:firefox",
        "test:e2e": "npm run build:chrome && playwright test",
        "test:sites": "npm run build:chrome && playwright test --config playwright.sites.config.js --headed",
        "test:sites:headless": "npm run build:chrome && playwright test --config playwright.sites.config.js",
        "test:custom": "node scripts/test-custom/test-custom.js",
        "verify:firefox": "npm run build:firefox && python3 scripts/verify-firefox/verify-firefox.py",
        "verify:firefox:sites": "npm run build:firefox && python3 scripts/verify-firefox/verify-firefox.py --sites",
        "verify:chrome": "npm run build:chrome && node scripts/verify-chrome/verify-chrome.js",
        "verify:chrome:sites": "npm run build:chrome && node scripts/verify-chrome/verify-chrome.js --sites"
    },
    "devDependencies": {
        "@clack/prompts": "^1.8.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "web-ext": "^10.8.0"
    },
    "engines": {
        "node": ">=26"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webextensions/close-tab-by-double-right-click.git"
    },
    "keywords": [
        "browser-extension",
        "chrome-extension",
        "close-tab",
        "double-right-click",
        "firefox-addon",
        "webextension"
    ],
    "author": "Priyank Parashar",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/webextensions/close-tab-by-double-right-click/issues"
    },
    "homepage": "https://github.com/webextensions/close-tab-by-double-right-click#readme"
}
